<UserControl x:Class="_00_elektro_bud.View.UserControls.ProduktControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:_00_elektro_bud.View.UserControls"
             mc:Ignorable="d" 
             d:DesignHeight="100" d:DesignWidth="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="30*"/>
            <RowDefinition Height="70*"/>
        </Grid.RowDefinitions>
        <Rectangle Fill="Wheat" Grid.ColumnSpan="2" Grid.RowSpan="2"/>
        <Label Content="Nazwa Produktu:" FontWeight="Bold" VerticalAlignment="Bottom"/>
        <Label Grid.Column="1" Content="Kod EAN Produktu:" FontWeight="Bold" VerticalAlignment="Bottom"/>
        <Label Grid.Column="0" FontSize="40" Grid.Row="1" Content="Produkt" VerticalAlignment="Bottom"/>
        <Label Grid.Column="1" FontSize="40" Grid.Row="1" Content="0000000000000" VerticalAlignment="Bottom"/>
    </Grid>
</UserControl>

<UserControl x:Class="_00_elektro_bud.View.UserControls.ProduktControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:_00_elektro_bud.View.UserControls"
             mc:Ignorable="d" 
             x:Name="wndProdukt"
             SizeChanged="wndProdukt_SizeChanged"
             d:DesignHeight="100" d:DesignWidth="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="0.1*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="40*"/>
            <RowDefinition Height="60*"/>
        </Grid.RowDefinitions>
        <Border Panel.ZIndex="1" x:Name="brdRamka" Grid.RowSpan="2" Grid.ColumnSpan="3" BorderBrush="Silver" BorderThickness="0 2 0 2" Visibility="Hidden"/>
        <Rectangle Visibility="Hidden" x:Name="rtgTlo" Fill="#EBF0F5" Grid.ColumnSpan="3" Grid.RowSpan="2" />
        <Label x:Name="txtNazwaTytul" Content="Nazwa Produktu:" FontWeight="Bold" VerticalAlignment="Bottom"/>
        <Label x:Name="txtEANTytul" Grid.Column="2" Content="Kod EAN Produktu:" FontWeight="Bold" VerticalAlignment="Bottom"/>
        <TextBlock x:Name="txtNazwa" Grid.Column="0" FontSize="40" Grid.Row="1" Text="Produkt" TextWrapping="Wrap" VerticalAlignment="Bottom" Margin="5 0 0 0"/>
        <TextBlock x:Name="txtEAN" Grid.Column="2" FontSize="40" Grid.Row="1" Text="0000000000000" VerticalAlignment="Top"/>

    </Grid>
</UserControl>

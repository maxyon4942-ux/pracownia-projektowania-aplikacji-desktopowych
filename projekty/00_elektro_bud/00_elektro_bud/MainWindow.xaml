<Window x:Class="_00_elektro_bud.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_00_elektro_bud"
        mc:Ignorable="d"
        Background="#75A0EA"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="23*"/>
            <RowDefinition Height="73*"/>
            <RowDefinition Height="4*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="10*"/>
            <ColumnDefinition Width="60*"/>
            <ColumnDefinition Width="30*"/>
        </Grid.ColumnDefinitions>
        <!--Top left-->
        <Grid Grid.Column="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="40*"/>
                <ColumnDefinition Width="30*"/>
                <ColumnDefinition Width="30*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="20*"/>
                <RowDefinition Height="20*"/>
                <RowDefinition Height="20*"/>
            </Grid.RowDefinitions>
            
            <Label Grid.Column="0" Grid.RowSpan="3" Content="Katalog Produktów" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <TextBox Grid.Column="1" Grid.Row="1" Margin="5 0"/>
            <ComboBox Grid.Column="2" Grid.Row="1" Margin="5 0"/>
        </Grid>
        <!--Katalog-->
        <Rectangle Fill="White" Grid.Row="1" Grid.Column="1"/>
        <Border Grid.Row="1" Grid.Column="1" BorderBrush="Silver" BorderThickness="2">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="5">
                <StackPanel>
                    <Label Content="Produkt 1" FontSize="20" Margin="10" HorizontalAlignment="Center"/>
                    <Label Content="Produkt 1" FontSize="20" Margin="10"/>
                    <Label Content="Produkt 1" FontSize="20" Margin="10"/>
                    <Label Content="Produkt 1" FontSize="20" Margin="10"/>
                    <Label Content="Produkt 1" FontSize="20" Margin="10"/>
                    <Label Content="Produkt 1" FontSize="20" Margin="10"/>
                    <Label Content="Produkt 1" FontSize="20" Margin="10"/>
                    <Label Content="Produkt 1" FontSize="20" Margin="10"/>
                    <Label Content="Produkt 1" FontSize="20" Margin="10"/>
                    <Label Content="Produkt 1" FontSize="20" Margin="10"/>
                    <Label Content="Produkt 1" FontSize="20" Margin="10"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>

<Window x:Class="_00_elektro_bud.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_00_elektro_bud"
        mc:Ignorable="d"
        Background="#EBF0F5"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="23*"/>
            <RowDefinition Height="73*"/>
            <RowDefinition Height="4*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="5*"/>
            <ColumnDefinition Width="58*"/>
            <ColumnDefinition Width="32*"/>
            <ColumnDefinition Width="5*"/>
        </Grid.ColumnDefinitions>
        <!--Top left-->
        <Grid Grid.Column="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="40*"/>
                <ColumnDefinition Width="30*"/>
                <ColumnDefinition Width="30*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="0*"/>
                <RowDefinition Height="40*"/>
                <RowDefinition Height="80*" MaxHeight="32"/>
            </Grid.RowDefinitions>

            <Label Grid.Column="0" Grid.RowSpan="4" Content="Katalog Produktów" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Bottom"/>
            <Label Content="Wyszukaj za pomocą: " Grid.Column="2" Grid.RowSpan="2" Grid.Row="0" VerticalAlignment="Bottom" HorizontalAlignment="Center"/>
            <TextBox VerticalContentAlignment="Center" Name="txtWyszukaj" Grid.Column="1" Grid.Row="2" Margin="5 0 0 5"/>
            <ComboBox VerticalContentAlignment="Center" Name="cmbTrybWyszukiwania" Grid.Column="2" Grid.Row="2" Margin="5 0 0 5">
                <ComboBoxItem Content="Nazwy"/>
                <ComboBoxItem Content="Kodu EAN"/>
            </ComboBox>
        </Grid>
        <!--Katalog-->
        <Rectangle Fill="White" Grid.Row="1" Grid.Column="1"/>
        <Border Grid.Row="1" Grid.Column="1" BorderBrush="Silver" BorderThickness="2">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="5">
                <StackPanel>
                    <Label Content="Produkt 1" FontSize="20" Margin="10" HorizontalAlignment="Center"/>
                    <Label Content="Produkt 1" FontSize="20" Margin="10"/>
                    <Label Content="Produkt 1" FontSize="20" Margin="10"/>
                    <Label Content="Produkt 1" FontSize="20" Margin="10"/>
                    <Label Content="Produkt 1" FontSize="20" Margin="10"/>
                    <Label Content="Produkt 1" FontSize="20" Margin="10"/>
                    <Label Content="Produkt 1" FontSize="20" Margin="10"/>
                    <Label Content="Produkt 1" FontSize="20" Margin="10"/>
                    <Label Content="Produkt 1" FontSize="20" Margin="10"/>
                    <Label Content="Produkt 1" FontSize="20" Margin="10"/>
                    <Label Content="Produkt 1" FontSize="20" Margin="10"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
        <!--Informacje o produkcie-->
        <Label FontSize="20" Content="Informacje o produkcie:" Grid.Row="0" Grid.Column="2" VerticalAlignment="Bottom" HorizontalAlignment="Center"/>
        <Rectangle Fill="White" Grid.Row="1" Grid.Column="2" Margin="15 0"/>
        <Border Grid.Row="1" Grid.Column="2" BorderBrush="Silver" BorderThickness="2" Margin="15 0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="5">
            </ScrollViewer>
        </Border>
    </Grid>
</Window>

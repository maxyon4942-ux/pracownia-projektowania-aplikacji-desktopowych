<Window x:Class="_00_elektro_bud.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_00_elektro_bud"
        xmlns:UserControls="clr-namespace:_00_elektro_bud.View.UserControls"
        mc:Ignorable="d"
        Background="#EBF0F5"
        Name="wndGlowne"
        SizeChanged="wndGlowne_SizeChanged"
        MinHeight="330" MinWidth="520"
        Title="Katalog produktów" Height="450" Width="800">
    <!--Zmiana domyślnego wyglądu przycisku na niewidoczny bez podświetlenia-->
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent"></Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="23*"/>
            <RowDefinition Height="73*"/>
            <RowDefinition Height="4*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="5*"/>
            <ColumnDefinition Width="58*"/>
            <ColumnDefinition Width="32*"/>
            <ColumnDefinition Width="5*"/>
        </Grid.ColumnDefinitions>
        <!--Góra-->
        <Grid Grid.Column="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="40*"/>
                <ColumnDefinition Width="30*"/>
                <ColumnDefinition Width="30*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="0*"/>
                <RowDefinition Height="40*"/>
                <RowDefinition Height="80*" MaxHeight="32"/>
            </Grid.RowDefinitions>

            <TextBlock Name="txtKatalogTytul" Grid.Column="0" Grid.RowSpan="4" Text="Katalog Produktów" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Bottom" TextWrapping="Wrap"/>
            <TextBlock Text="Wyszukaj za pomocą: " Grid.Column="2" Grid.RowSpan="2" Grid.Row="0" VerticalAlignment="Bottom" HorizontalAlignment="Left" TextWrapping="Wrap"/>
            <TextBox TextChanged="txtWyszukaj_TextChanged" VerticalContentAlignment="Center" Name="txtWyszukaj" Grid.Column="1" Grid.Row="2" Margin="5 0 0 5"/>
            <ComboBox SelectedIndex="0" SelectionChanged="cmbTrybWyszukiwania_SelectionChanged" VerticalContentAlignment="Center" Name="cmbTrybWyszukiwania" Grid.Column="2" Grid.Row="2" Margin="5 0 0 5">
                <ComboBoxItem Content="Nazwy"/>
                <ComboBoxItem Content="Kodu EAN"/>
            </ComboBox>
        </Grid>
        <!--Katalog-->
        <Rectangle Fill="White" Grid.Row="1" Grid.Column="1"/>
        <Border Grid.Row="1" Grid.Column="1" BorderBrush="Silver" BorderThickness="2">
            <Grid>
                <Rectangle Name="rtgBrakWyszukanych" Fill="Black" Opacity="0.3" Panel.ZIndex="1"/>
                <TextBlock Name="txtBrakWyszukanych" Text="Brak produktów spełniających kryteria wyszukiwania" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="15" Visibility="Hidden" TextAlignment="Center" TextWrapping="Wrap" Panel.ZIndex="2" Padding="10"/>
                <ScrollViewer VerticalScrollBarVisibility="Visible" Padding="0, 5">
                    <StackPanel>
                        <ItemsControl Name="itmKatalog">
                            <Grid> 
                                <Button Panel.ZIndex="1" Click="ProduktKlikniety"/>
                            </Grid>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
        <!--Informacje o produkcie-->
        <TextBlock Name="txtInformacjeTytul" FontSize="20" Text="Informacje o produkcie" Grid.Row="0" Grid.Column="2" VerticalAlignment="Bottom" HorizontalAlignment="Center" TextWrapping="Wrap"/>
        <Rectangle Fill="White" Grid.Row="1" Grid.Column="2" Margin="15 0"/>
        <Border Grid.Row="1" Grid.Column="2" BorderBrush="Silver" BorderThickness="2" Margin="15 0">
            <Grid>
                <Rectangle Name="rtgBrakWybranego" Fill="Black" Opacity="0.3" Panel.ZIndex="1" Visibility="Hidden"/>
                <TextBlock Name="txtBrakWybranego" Text="Wybierz produkt aby wyświetlić o nim informacje" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="15" Visibility="Hidden" TextWrapping="Wrap" TextAlignment="Center" Panel.ZIndex="2" Padding="10"/>
                <ScrollViewer VerticalScrollBarVisibility="Visible" Padding="5">
                    <StackPanel>
                        <Label Name="txtL1" Content="Nazwa:" FontWeight="Bold" VerticalAlignment="Bottom"/>
                        <TextBlock Name="txtNazwa" FontSize="20" Text="TestName" VerticalAlignment="Bottom" TextWrapping="Wrap" Margin="5 0 0 0"/>
                        <Label Name="txtL2" Content="Kod EAN:" FontWeight="Bold" VerticalAlignment="Bottom"/>
                        <TextBlock Name="txtEAN" FontSize="20" Text="TestName" VerticalAlignment="Bottom" TextWrapping="Wrap" Margin="5 0 0 0"/>
                        <Label Name="txtL3" Content="Kategoria:" FontWeight="Bold" VerticalAlignment="Bottom"/>
                        <TextBlock Name="txtKategoria" FontSize="20" Text="TestName" VerticalAlignment="Bottom" TextWrapping="Wrap" Margin="5 0 0 0"/>
                        <Label Name="txtL4" Visibility="Hidden" Content="Miejsce w magazynie:" FontWeight="Bold" VerticalAlignment="Bottom"/>
                        <TextBlock Name="txtSektor" Text="- test" VerticalAlignment="Bottom" FontSize="20" Margin="5 0 0 0" TextWrapping="Wrap"/>
                        <TextBlock Name="txtRegal" Text="- test" VerticalAlignment="Bottom" FontSize="20" Margin="5 0 0 0" TextWrapping="Wrap"/>
                        <TextBlock Name="txtPolka" Text="- test"  VerticalAlignment="Bottom" FontSize="20" Margin="5 0 0 0" TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>
